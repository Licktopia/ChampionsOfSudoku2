<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.licktopia.thechampionofsudoku">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:screenOrientation="nosensor"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/app_id" />
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id"/>
        <provider android:authorities="com.facebook.app.FacebookContentProvider308707836247832"
            android:name="com.facebook.FacebookContentProvider"
            android:exported="true"/>

        <activity android:name="com.licktopia.thechampionofsudoku.Activities.BoardActivity"></activity>
        <activity android:name="com.licktopia.thechampionofsudoku.Activities.InstructionsActivity"></activity>
        <activity android:name="com.licktopia.thechampionofsudoku.Activities.AboutActivity"></activity>
        <activity android:name="com.licktopia.thechampionofsudoku.Activities.MainMenuActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.licktopia.thechampionofsudoku.Settings.SudokuSettingsActivity"
            android:label="Settings"
            android:theme="@style/Base.Theme.AppCompat.Light" />
        <activity android:name="com.licktopia.thechampionofsudoku.Activities.GamerProfileActivity"></activity>
    </application>

</manifest>