<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.licktopia.championsofsudoku">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:screenOrientation="nosensor"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/app_id" />

        <activity android:name=".Activities.BoardActivity"></activity>
        <activity android:name=".Activities.InstructionsActivity"></activity>
        <activity android:name=".Activities.AboutActivity"></activity>
        <activity android:name=".Activities.MainMenuActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Settings.SudokuSettingsActivity"
            android:label="Settings"
            android:theme="@style/Base.Theme.AppCompat.Light" />
        <activity android:name=".Sudoku.GamerProfileActivity"></activity>
    </application>

</manifest>