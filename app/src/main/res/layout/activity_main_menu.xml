<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundcroppedsmall"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:weightSum="100">

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        tools:visibility="visible">

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:background="#96f1f1f1"
            android:gravity="center"
            android:text="Try Harder Puzzles to Gain more XP"
            android:textColor="@color/colorPrimaryDark"
            android:visibility="invisible"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18"
            android:orientation="horizontal"
            android:weightSum="100">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:orientation="vertical"></LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="70"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="25"
                    android:paddingBottom="10dp"
                    android:scaleX="1"
                    android:scaleY="1"
                    android:src="@drawable/sudoku"
                    app:srcCompat="@drawable/sudoku" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="15"
                android:orientation="vertical">

                <Button
                    android:id="@+id/resume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resume  Game" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="53"
            android:orientation="horizontal"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="70"
                android:orientation="horizontal"
                android:weightSum="100"
                tools:visibility="visible">

                <RelativeLayout
                    android:id="@+id/rely"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="15">

                    <!-- sign-out button -->
                    <Button
                        android:id="@+id/sign_out_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign Out"
                        android:visibility="gone" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="false"
                    android:layout_weight="70"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:weightSum="100"
                    tools:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/menu_layout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_above="@+id/lickbar"

                        android:layout_below="@+id/imageView6"
                        android:layout_centerInParent="true"
                        android:layout_centerVertical="true"
                        android:layout_weight="100"
                        android:background="@android:color/transparent"
                        android:gravity="top"
                        android:orientation="vertical"
                        android:visibility="visible"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/level_select"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:orientation="vertical"
                            android:visibility="visible"
                            android:weightSum="12"
                            tools:visibility="visible">

                            <RelativeLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/beginnerButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/textView111"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="false"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/beginner"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/beginnericon"
                                    app:srcCompat="@drawable/beginnericon" />

                            </RelativeLayout>

                            <RelativeLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/easyButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/textView112"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentStart="true"
                                    android:layout_alignParentTop="true"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/easy"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/easyicon"
                                    app:srcCompat="@drawable/easyicon" />

                            </RelativeLayout>

                            <RelativeLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/mediumButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/textView113"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="false"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/medium"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/mediumicon"
                                    app:srcCompat="@drawable/mediumicon" />

                            </RelativeLayout>

                            <RelativeLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/hardButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/textView114"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="false"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/hard"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/hardicon"
                                    app:srcCompat="@drawable/hardicon" />

                            </RelativeLayout>

                            <RelativeLayout

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/expertButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/textView115"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="false"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/expert"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/experticon"
                                    app:srcCompat="@drawable/experticon" />

                            </RelativeLayout>

                            <RelativeLayout

                                android:id="@+id/master_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="2"
                                android:background="@android:color/transparent"
                                android:visibility="visible">

                                <ImageButton
                                    android:id="@+id/masterButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/art_button"
                                    android:capitalize="none"
                                    android:textAlignment="center"
                                    android:textAllCaps="false"
                                    android:textSize="18sp"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/master_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="false"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="20dp"
                                    android:text="@string/master"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/master_icon"
                                    android:layout_width="35dp"
                                    android:layout_height="35dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_alignParentTop="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="10dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/mastericon"
                                    app:srcCompat="@drawable/mastericon" />

                            </RelativeLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/mode_select"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:addStatesFromChildren="false"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:weightSum="100"
                            tools:visibility="gone">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginBottom="14dp"
                                android:layout_weight="50">

                                <ImageButton
                                    android:id="@+id/topiaChoice"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/art_button"
                                    android:text="Colortopia"
                                    android:textColor="@android:color/black"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/textView7"
                                    android:layout_width="100dp"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentBottom="true"
                                    android:layout_centerHorizontal="false"
                                    android:layout_marginBottom="15dp"
                                    android:layout_marginLeft="15dp"
                                    android:gravity="bottom"
                                    android:text="@string/art_mode"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="20sp" />

                                <ImageView
                                    android:id="@+id/imageView3"
                                    android:layout_width="100dp"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginBottom="3dp"
                                    android:layout_marginRight="15dp"
                                    android:layout_marginTop="3dp"
                                    android:layout_weight="5"
                                    android:src="@drawable/peacock"
                                    app:srcCompat="@drawable/peacock" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="50"
                                android:background="@drawable/rounded_button2">

                                <ImageButton
                                    android:id="@+id/numberChoice"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/art_button"
                                    android:text="Colortopia"
                                    android:textColor="@android:color/black"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/imageView3"
                                    android:layout_width="100dp"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentLeft="true"
                                    android:layout_alignParentRight="false"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="15dp"
                                    android:layout_weight="5"
                                    android:src="@drawable/rocket"
                                    app:srcCompat="@drawable/rocket" />

                                <TextView
                                    android:id="@+id/textView7"
                                    android:layout_width="100dp"
                                    android:layout_height="match_parent"
                                    android:layout_alignParentBottom="true"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerHorizontal="false"
                                    android:layout_marginRight="15dp"
                                    android:layout_marginTop="15dp"
                                    android:gravity="right"
                                    android:lines="2"
                                    android:maxLines="2"
                                    android:text="@string/classic_numbers"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="20sp" />
                            </RelativeLayout>

                            <ImageButton
                                android:id="@+id/menu_back"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/back_button"
                                android:padding="10dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/backarrow"
                                android:text="Back"
                                android:textSize="12sp"
                                app:srcCompat="@drawable/backarrow" />


                        </LinearLayout>

                    </RelativeLayout>


                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rely"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="15">

                    <Button
                        android:id="@+id/test_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test Add"
                        android:visibility="gone" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lickbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@+id/share_bar"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="30dp"
            android:layout_weight="17"
            android:orientation="horizontal"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1">

                <LinearLayout

                    android:id="@+id/signin_button"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:background="@drawable/back_button"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:weightSum="100"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imageView4"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_alignParentLeft="false"
                        android:layout_alignParentStart="false"
                        android:layout_gravity="center"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/googlelogo" />

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginBottom="7dp"
                        android:layout_marginLeft="7dp"
                        android:layout_marginRight="7dp"
                        android:gravity="center"
                        android:text="@string/sign_in_button"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:weightSum="100"
                    tools:visibility="gone">

                    <ImageView
                        android:id="@+id/user_stats"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_alignParentLeft="false"
                        android:layout_alignParentStart="false"
                        android:layout_alignParentTop="false"
                        android:layout_gravity="center"
                        android:layout_weight="75"
                        android:scaleType="fitCenter"
                        android:visibility="visible"
                        app:srcCompat="@drawable/rank0"
                        tools:visibility="gone" />

                    <TextView
                        android:id="@+id/user_name"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_alignParentBottom="false"
                        android:layout_centerHorizontal="true"
                        android:layout_weight="25"
                        android:gravity="center"
                        android:text="@string/stats_amp_more"
                        android:textSize="14sp"
                        android:visibility="visible" />
                </LinearLayout>

            </RelativeLayout>

            <ImageView
                android:id="@+id/lick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:alpha="1"
                android:scaleType="fitCenter"
                android:scaleX=".85"
                android:scaleY=".85"
                android:src="@drawable/licktopia_centered"
                app:srcCompat="@drawable/licktopia_centered" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/share_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="false"
            android:layout_weight="7"
            android:background="#41666666"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="@string/share_with_your_friends"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/share"
                    app:srcCompat="@drawable/share" />
            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
